# ==============================================================================
# FATHOM — ENVIRONMENT VARIABLES
# ==============================================================================
# All API keys live on the server. Users never enter keys in the app.
#
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# DEEPGRAM (transcription + diarization)
# ------------------------------------------------------------------------------
# Used server-side for batch transcription (uploads and the recording that is
# finalized after a live session). Give this key the `keys:write` scope so the
# app can mint ten-minute browser keys for live streaming without exposing it.
DEEPGRAM_API_KEY=

# Only needed if DEEPGRAM_API_KEY lacks `keys:write`. This value is shipped to
# the browser for the live websocket, so scope it to `usage:write` only.
NEXT_PUBLIC_DEEPGRAM_API_KEY=

# Optional. Batch uploads are transcoded to 16 kHz mono Opus before hitting
# Deepgram when ffmpeg is available; point this at the binary if it isn't on
# a standard path.
# FFMPEG_PATH=/usr/bin/ffmpeg

# ------------------------------------------------------------------------------
# OPENROUTER (summaries + Ask)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=

# Model used for every summary and question. Free-tier keys can only use
# models ending in ":free".
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional. Requests past this deadline fall through to the built-in local
# summary so the recorder never hangs on a slow model.
# OPENROUTER_TIMEOUT_MS=45000
