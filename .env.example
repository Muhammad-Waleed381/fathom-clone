# ==============================================================================
# FATHOM AI NOTETAKER — ENVIRONMENT VARIABLES
# ==============================================================================
# The application includes offline fallbacks for all features, but to test
# live STT diarization and live LLM summarization end-to-end, populate
# the keys below and rename/copy this file to .env.local:
#
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEEPGRAM API KEY (Speech-to-Text & Diarization)
# ------------------------------------------------------------------------------
# Required for: Live microphone audio transcription, multi-speaker diarization,
# and sub-second word-level timestamp extraction.
# Obtain a free key from: https://console.deepgram.com/ (includes $200 free credit)
DEEPGRAM_API_KEY=
NEXT_PUBLIC_DEEPGRAM_API_KEY=

# ------------------------------------------------------------------------------
# 2. OPENROUTER API KEY (LLM Summarization & Ask Fathom Chat)
# ------------------------------------------------------------------------------
# Required for: Generating dynamic summaries across 4 lenses (Executive, Engineering,
# Sales, Action Items) and answering queries in Ask Fathom with cited timestamps.
# Obtain a key from: https://openrouter.ai/keys (free tier models like Llama 3.3 70B supported)
OPENROUTER_API_KEY=
NEXT_PUBLIC_OPENROUTER_API_KEY=

# Optional model override (Default: meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
